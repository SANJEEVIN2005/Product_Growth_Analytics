# ============================================================
# .env.example
# Copy this file to .env and fill in your Oracle credentials.
# .env is gitignored and will never be pushed to GitHub.
# ============================================================

# Database Connection
DB_HOST=localhost
DB_PORT=1521
DB_SERVICE=XEPDB1

# Primary Analytical User
DB_USER=growth_user
DB_PASSWORD=your_secure_password_here

# Read-Only User for Ask-Your-Data Layer
READONLY_USER=growth_readonly
READONLY_PASSWORD=your_readonly_password_here
